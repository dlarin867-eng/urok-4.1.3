# Model provider: anthropic (default, Claude) | bedrock (original Amazon Nova Pro)
AI_PROVIDER=anthropic
# Claude: API key from console.anthropic.com - better as a user environment variable than here
ANTHROPIC_API_KEY=your-anthropic-key
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Server-side retry on another model if Claude declines (set "off" to disable)
AI_FALLBACKS=default

# Cost guards (per server process, per day)
AI_DAILY_LIMIT=30
AI_QA_DAILY_LIMIT=100

# Shared secret between the page and the functions (must match)
APP_API_SECRET_KEY=your-api-secret
VITE_API_SECRET_KEY=your-api-secret

# Only for AI_PROVIDER=bedrock
BEDROCK_AWS_ACCESS_KEY_ID=your-key
BEDROCK_AWS_SECRET_ACCESS_KEY=your-secret
BEDROCK_REGION=eu-west-2
